.PHONY: build test clean run

build:
	@echo "Compiling project..."
	@sleep 0.3
	@echo "Build successful!"

test:
	@echo "Running tests..."
	@sleep 0.3
	@echo "test_add ... ok"
	@echo "test_sub ... ok"
	@echo "All tests passed!"

clean:
	@echo "Cleaning build artifacts..."
	@sleep 0.2
	@echo "Done."

run: build
	@echo "Starting application..."
	@echo "Hello from erun.nvim!"
